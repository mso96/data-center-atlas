{
  "name": "data-center-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "import": "node --import tsx scripts/import.ts",
    "research": "node --import tsx scripts/research.ts",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --include-runtime=false",
    "cf:build": "ATLAS_RUNTIME=cloudflare opennextjs-cloudflare build && node scripts/check-cloudflare-bundle.mjs",
    "cf:preview": "opennextjs-cloudflare preview --port 3002",
    "cf:deploy": "node scripts/check-cloudflare-deploy.mjs && npm run cf:build && opennextjs-cloudflare deploy",
    "cf:db:migrate:local": "wrangler d1 migrations apply atlas --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply atlas --remote",
    "cf:db:export": "node --import tsx scripts/export-d1.ts",
    "cf:db:import:local": "wrangler d1 execute atlas --local --file data/d1-snapshot.sql",
    "cf:db:import:remote": "wrangler d1 execute atlas --remote --file data/d1-snapshot.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.50.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.19.0"
}
